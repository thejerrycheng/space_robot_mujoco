<mujoco model="rocket-thrust-plume">
  <compiler angle="degree" coordinate="local"/>
  <option timestep="0.01" gravity="0 0 -9.81" integrator="RK4"/>

  <visual>
    <quality shadowsize="2048"/>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0.1 0.1 0.1"/>
    <map znear="0.001" zfar="50"/>
  </visual>

  <default>
    <geom contype="1" conaffinity="1" friction="0.8 0.1 0.01" rgba="0.8 0.8 0.8 1"/>
    <site rgba="0.2 0.6 1.0 0.9"/>
    <joint damping="0.02" limited="true" range="-90 90"/>
    <motor ctrllimited="true" ctrlrange="-2 2"/>
  </default>

  <asset>
    <texture name="grid" type="2d" builtin="checker"
             rgb1="0.9 0.9 0.9" rgb2="0.7 0.7 0.7"
             width="600" height="600"/>
    <material name="grid" texture="grid" texrepeat="10 10" reflectance="0.1"/>
  </asset>

  <worldbody>

    <!-- ground -->
    <geom name="ground" type="plane" size="10 10 0.1"
          material="grid" rgba="1 1 1 1"/>

    <!-- rocket body -->
    <body name="ball" pos="0 0 1">
        <freejoint name="ball_free"/>

        <!-- Rocket COM inertial -->
        <inertial pos="0 0 0" mass="100" diaginertia="0.010 0.010 0.003"/>

        <!-- body -->
        <geom name="rocket_fuselage" type="cylinder"
                fromto="0 0 -0.25   0 0 0.25" size="0.08"
                rgba="0.85 0.2 0.2 1"/>

        <geom name="rocket_nose" type="ellipsoid"
                pos="0 0 0.37" size="0.08 0.08 0.12"
                rgba="0.9 0.3 0.3 1"/>

        <!-- fins -->
        <geom name="fin_xp" type="box" pos="0.12 0 -0.22" size="0.10 0.005 0.04"/>
        <geom name="fin_xn" type="box" pos="-0.12 0 -0.22" size="0.10 0.005 0.04"/>
        <geom name="fin_yp" type="box" pos="0 0.12 -0.22" size="0.005 0.10 0.04"/>
        <geom name="fin_yn" type="box" pos="0 -0.12 -0.22" size="0.005 0.10 0.04"/>

        <!-- thruster mount -->
        <body name="thruster_mount" pos="0 0 -0.25">
            <inertial pos="0 0 0" mass="20" diaginertia="1e-4 1e-4 1e-4"/>

            <joint name="thruster_yaw" type="hinge" axis="1 0 0"
                   range="-30 30" damping="0.0"/>

            <!-- pitch gimbal -->
            <body name="thruster_gimbal" pos="0 0 0">
                <inertial pos="0 0 0" mass="30" diaginertia="2e-4 2e-4 2e-4"/>

                <joint name="thruster_pitch" type="hinge" axis="0 1 0"
                       range="-30 30" damping="0.0"/>

                <!-- nozzle -->
                <geom name="thruster_geom" type="cylinder"
                      fromto="0 0 0   0 0 -0.25" size="0.02"
                      rgba="0.2 0.6 1.0 0.7"/>

                <!-- thrust site -->
                <site name="thrust_site" pos="0 0 -0.25" size="0.01"
                      type="sphere" rgba="0.2 0.6 1.0 0.9"/>

                <!-- plume visual (stretch capsule) -->
                <geom name="plume_geom" type="capsule"
                      fromto="0 0 -0.25   0 0 -0.25"
                      size="0.03"
                      rgba="0.2 0.6 1 0.4"
                      contype="0" conaffinity="0" group="5"/>
            </body>
        </body>
    </body>

  </worldbody>

  <actuator>
    <motor name="yaw_motor" joint="thruster_yaw" gear="1"
           ctrllimited="true" ctrlrange="-50 50"/>

    <motor name="pitch_motor" joint="thruster_pitch" gear="1"
           ctrllimited="true" ctrlrange="-50 50"/>

    <general name="thrust" site="thrust_site"
             gear="0 0 1 0 0 0"
             biastype="none"
             ctrllimited="true" ctrlrange="0 2200"/>
  </actuator>

</mujoco>
