<!-- Here is the summry of the parameters used in the environment XML file located at assets/mjcf/realistic_param.xml:
For the rocket: the mass is set to 5,000,000 kg, 
the diagonal inertia tensor is set to [1.2e9, 1.2e9, 3.0e7] kg·m², 
the thruster is positioned 30 meters below the rocket's center of mass, 
the gimbal joints (yaw and pitch) have a range of ±30 degrees, 
and the thrust magnitude is set to allow for a thrust-to-weight ratio of approximately 3 on the Moon.

In addition, the thruster geometry is defined as a cylinder extending from the gimbal position downwards by 10 meters with a radius of 1.5 meters, 
and the thrust site is represented as a sphere with a radius of 3 meters located at the end of the thruster.

The moon surface is modeled using a mesh named "moon_terrain" positioned at z = -56 to simulate the lunar surface.
The rocket visualization mesh "tintin_rocket" is positioned 50 meters above the rocket's root body to accurately represent its appearance during flight.
The background skybox uses a gradient texture transitioning from rgb1="0.3 0.5 0.7" to rgb2="0 0 0" to simulate the lunar sky.
Here is the complete XML code for the environment: -->

<mujoco model="ball-thrust-universal">
  <compiler angle="degree" coordinate="local"/>
  <option timestep="0.01" gravity="0 0 -1.62" integrator="RK4"/>

  <visual>
    <quality shadowsize="2048"/>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0.1 0.1 0.1"/>
    <map znear="0.001" zfar="200"/>
  </visual>
      <include file="skybox.xml" />
      <include file="materials.xml" />
  <default>
    <geom contype="1" conaffinity="1"
          friction="0.8 0.1 0.01"
          rgba="0.8 0.8 0.8 1"/>
    <site rgba="0.2 0.6 1.0 0.9"/>
    <joint damping="0.1" limited="true" range="-90 90"/>
    <motor ctrllimited="true" ctrlrange="-2 2"/>
  </default>

  <asset>
      <texture type="skybox" builtin="gradient"
               rgb1="0.3 0.5 0.7" rgb2="0 0 0"
               width="512" height="3072"/>

      <texture type="2d" name="groundplane" builtin="checker"
               mark="edge" rgb1="0.9 0.9 0.9" rgb2="0.7 0.7 0.7"
               markrgb="0.8 0.8 0.8" width="300" height="300"/>

      <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>

      <mesh name="tintin_rocket" file="../meshes/tintin_visualization.obj" 
        scale="1 1 1"/>

      <mesh name="moon_terrain" file="../meshes/simple_moon_terrain.obj"
        scale="0.1 0.1 0.1"/>

      <material name="target_ring" rgba="0.2 0.8 0.2 0.8" reflectance="0.2"/>

  </asset>

  <worldbody>

    <!-- MOON GROUND -->
    <!-- <geom name="ground" type="plane"
          size="200 200 1"
          material="groundplane"
          rgba="1 1 1 1"/> -->

      <geom name="moon_surface" type="mesh" mesh="moon_terrain"
          pos="0 0 -56"
          rgba="0.7 0.7 0.7 1"
          contype="1" conaffinity="1"/>

    <!-- Landing target ring -->
    <geom name="landing_ring"
          type="cylinder"
          pos="0 0 0"
          size="50 1"
          rgba="0.2 0.8 0.2 0.8"
          material="target_ring"
          contype="1" conaffinity="1"/>

    <!-- ========================================================= -->
    <!-- ROCKET ROOT BODY (100m tall, 10m diameter, 5000-ton mass) -->
    <!-- ========================================================= -->
    <body name="ball" pos="0 0 150">
        <freejoint name="ball_free"/>

        <!-- realistic huge inertia for a 5000-ton, 100m long tube -->
        <inertial pos="0 0 0" mass="5000000"
                  diaginertia="1.2e9 1.2e9 3.0e7"/>

        <!-- rocket visualization mesh, positioned 50m above root -->
      <geom name="tintin_visual" type="mesh" mesh="tintin_rocket"
              pos="0 0 50"
              contype="1" conaffinity="1" 
              group="2"
              rgba="0.8 0.1 0.1 1"/>

        <!-- fuselage -->
        <!-- <geom name="rocket_fuselage" type="cylinder"
              fromto="0 0 -50  0 0 50"
              size="5"
              rgba="0.85 0.2 0.2 1" /> -->
        <!-- nose cone
        <geom name="rocket_nose" type="ellipsoid"
              pos="0 0 50"
              size="5 5 8"
              rgba="0.9 0.3 0.3 1"/> -->

        <!-- ========================================================= -->
        <!-- GIMBAL + ENGINE (COLLISION DISABLED)                     -->
        <!-- ========================================================= -->

        <!-- This is the most important part! - the offset of the thrust from the center of mass is 30 meters downwards
         to create a significant torque when applying thrust. -->

      <!-- In addition, the range of the gimbal joints is set to +/- 30 degrees to allow for more control authority.
         and the magnitude of the thrust is increased to allow for a thrust-to-weight ratio of ~3 on the Moon.  -->

        <body name="thruster_mount" pos="0 0 -30"> 

            <inertial pos="0 0 0" mass="1"
                      diaginertia="1e-4 1e-4 1e-4"/>

            <joint name="thruster_yaw" type="hinge"
                   axis="1 0 0"
                   range="-30 30" damping="0.01"/>

            <body name="thruster_gimbal" pos="0 0 0">

                <inertial pos="0 0 0" mass="1"
                          diaginertia="2e-4 2e-4 2e-4"/>

                <joint name="thruster_pitch" type="hinge"
                       axis="0 1 0"
                       range="-30 30" damping="0.01"/>

                <!-- Thruster geometry -->
                <geom name="thruster_geom" type="cylinder"
                      fromto="0 0 0  0 0 -10"
                      size="1.5"
                      rgba="0.8 0.4 0 0.7"
                      contype="0" conaffinity="0"/>

                <site name="thrust_site" pos="0 0 0"
                      type="sphere" size="3"
                      rgba="0.8 0.8 0.8 0.7"/>
            </body>
        </body>

    </body>

  </worldbody>

  <!-- ========================================================= -->
  <!-- Actuators: Yaw, Pitch, and THRUST (TWR ~ 3 on the Moon)   -->
  <!-- ========================================================= -->
 <actuator>
    <position name="yaw_servo" joint="thruster_yaw"
               ctrllimited="true" ctrlrange="-1 1"/>

    <position name="pitch_servo" joint="thruster_pitch"
               ctrllimited="true" ctrlrange="-1 1"/>

    <general name="thrust" site="thrust_site"
             gear="0 0 1 0 0 0"
             biastype="none"
             ctrllimited="true" ctrlrange="0 25000000"/>
  </actuator>

</mujoco>
